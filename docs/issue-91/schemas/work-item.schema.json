{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joselunasrt8-creator/MindShift-/docs/issue-91/schemas/work-item.schema.json",
  "title": "MindShift work-continuation work item v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["work_item_id", "repository", "source_issue_or_artifact", "cutoff_timestamp", "proposed_work", "target_uncertainty", "expected_evidence", "downstream_decision", "known_prerequisites", "known_blockers", "estimated_cost", "known_alternatives", "evidence_refs", "evidence_hashes", "reconstruction_procedure", "excluded_post_cutoff_material", "known_limitations"],
  "properties": {
    "work_item_id": {"type": "string", "pattern": "^MS91-WI-[0-9]{3}$"},
    "repository": {"const": "https://github.com/joselunasrt8-creator/MindShift-"},
    "source_issue_or_artifact": {"type": "object", "additionalProperties": false, "required": ["identity", "commit", "path", "sha256"], "properties": {"identity": {"type": "string", "minLength": 1}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "cutoff_timestamp": {"type": "string", "format": "date-time"},
    "proposed_work": {"type": "string", "minLength": 1},
    "target_uncertainty": {"type": "string", "minLength": 1},
    "expected_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "downstream_decision": {"type": "string", "minLength": 1},
    "known_prerequisites": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "known_blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "estimated_cost": {"type": ["string", "null"]},
    "known_alternatives": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E-[0-9]+$"}, "uniqueItems": true},
    "evidence_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "reconstruction_procedure": {"type": "string", "minLength": 1},
    "excluded_post_cutoff_material": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "known_limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
